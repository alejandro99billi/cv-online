---
import Section from "../Section.astro"

import { getCv, ui, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const { work } = getCv(lang)

const formatDate = (date: string | null) =>
  date == null
    ? t.present
    : new Date(date).toLocaleDateString(t.locale, { month: "short", year: "numeric" })
---

<Section title={t.experience}>
  <ul>
    {
      work.map(({ name, startDate, endDate, position, summary, highlights, url }) => (
        <li>
          <article>
            <header>
              <div>
                <h3>
                  {url ? (
                    <a href={url} title={t.see(name)} target="_blank" rel="noopener noreferrer">
                      {name}
                    </a>
                  ) : (
                    name
                  )}
                </h3>
                <h4>{position}</h4>
              </div>

              <div>
                <time datetime={startDate}>{formatDate(startDate)}</time>
                {" - "}
                <time datetime={endDate ?? undefined}>{formatDate(endDate)}</time>
              </div>
            </header>

            <footer>
              {summary && <p>{summary}</p>}
              {highlights.length > 0 && (
                <ul class="highlights">
                  {highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
              )}
            </footer>
          </article>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article a {
    color: #111;
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    color: #222;
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
    cursor: default;
  }

  .highlights {
    display: block;
    list-style: disc;
    padding-left: 1.2rem;
    gap: 4px;
    margin-top: 4px;
    color: #333;
    font-size: 0.9rem;
  }

  time {
    white-space: nowrap;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>
