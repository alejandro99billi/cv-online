---
import Section from "../Section.astro"

import { getCv, ui, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const { languages } = getCv(lang)
const NAMES = t.languageNames
---

<Section title={t.languages}>
  <ul>
    {
      languages.map(({ language, fluency }) => (
        <li>
          <strong>{NAMES[language] ?? language}</strong>: {fluency}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
</style>
